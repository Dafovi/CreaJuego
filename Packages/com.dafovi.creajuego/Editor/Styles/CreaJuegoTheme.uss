.creajuego {
    --cj-bg: #edf2f8;
    --cj-panel: #ffffff;
    --cj-text: #14264b;
    --cj-muted: #405574;
    --cj-accent: #075bd8;
    --cj-border: #c4d2e5;
    --cj-success: #08743f;
    --cj-success-bg: #eaf8ef;
    --cj-warning: #80500a;
    --cj-warning-bg: #fff6e7;
    --cj-danger: #ac2538;
    background-color: var(--cj-bg);
    color: var(--cj-text);
    padding: 12px;
    font-size: 14px;
}
.creajuego .header { flex-direction: row; align-items: center; margin-bottom: 6px; }
.creajuego .brand { flex-grow: 1; }
.creajuego .title { font-size: 25px; -unity-font-style: bold; }
.creajuego .subtitle { font-size: 12px; color: var(--cj-muted); }
.creajuego Button {
    min-height: 32px; padding: 5px 10px; margin: 2px;
    border-radius: 5px; border-width: 1px; border-color: var(--cj-border);
    background-color: var(--cj-panel); color: var(--cj-text);
}
.creajuego Button:hover { background-color: #eaf2ff; border-color: var(--cj-accent); }
.creajuego Button:active { background-color: #cfdef6; }
.creajuego Button:focus { border-color: var(--cj-accent); border-width: 2px; }
.creajuego Button:disabled { opacity: 0.55; }
.creajuego .flow { flex-direction: row; margin-bottom: 6px; }
.creajuego .flow-step {
    flex-grow: 1; font-size: 12px; color: var(--cj-muted);
    padding: 4px 6px; border-bottom-width: 2px; border-bottom-color: transparent;
}
.creajuego .flow-step.current { color: var(--cj-accent); -unity-font-style: bold; border-bottom-color: var(--cj-accent); }
.creajuego .toolbar { flex-direction: row; align-items: center; margin-bottom: 8px; }
.creajuego .toolbar .hint { flex-grow: 1; flex-shrink: 1; margin-left: 8px; }
.creajuego .columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.creajuego .left-column {
    width: 42%; max-width: 360px; margin-right: 10px; flex-shrink: 0; min-height: 0;
    background-color: var(--cj-panel); padding: 10px; border-radius: 6px;
}
.creajuego .properties {
    flex-grow: 1; min-width: 0; min-height: 0;
    background-color: var(--cj-panel); padding: 10px; border-radius: 6px;
}
.creajuego .section-title { font-size: 17px; -unity-font-style: bold; color: var(--cj-accent); margin: 0 0 4px 0; }
.creajuego .catalog { flex-grow: 3; flex-basis: 0; min-height: 48px; margin-top: 6px; margin-bottom: 8px; }
.creajuego .creation-grid { flex-direction: row; flex-wrap: wrap; }
.creajuego .card {
    flex-direction: column; justify-content: center; align-items: center;
    width: 45%; flex-grow: 1; min-width: 85px; min-height: 82px;
    margin: 3px; padding: 6px; background-color: #f5f8ff;
}
.creajuego .card .item-icon { width: 36px; height: 36px; margin: 0 0 5px 0; }
.creajuego .card-title { font-size: 13px; -unity-font-style: bold; color: var(--cj-accent); white-space: normal; -unity-text-align: middle-center; }
.creajuego .item-icon { width: 32px; height: 32px; flex-shrink: 0; margin-right: 10px; }
.creajuego .game-items { flex-grow: 2; flex-basis: 0; min-height: 48px; margin-top: 6px; }
.creajuego .scene-item { flex-direction: row; align-items: center; min-height: 32px; padding: 4px 6px; border-color: transparent; }
.creajuego .scene-item .item-icon { width: 21px; height: 21px; margin-right: 7px; }
.creajuego .scene-item-name { flex-grow: 1; flex-shrink: 1; white-space: normal; }
.creajuego .selection-mark { width: 18px; -unity-font-style: bold; }
.creajuego .scene-item.selected { background-color: #d6e7ff; border-left-width: 3px; border-left-color: var(--cj-accent); -unity-font-style: bold; }
.creajuego .hint { font-size: 12px; color: var(--cj-muted); white-space: normal; margin-top: 3px; }
.creajuego .selection-heading {
    flex-direction: row; flex-wrap: wrap; align-items: center;
    padding: 12px; margin: 4px 3px 12px 0;
    border-width: 1px; border-color: var(--cj-border); border-radius: 6px; background-color: #f5f8ff;
}
.creajuego .selection-title { font-size: 19px; -unity-font-style: bold; white-space: normal; flex-shrink: 1; }
.creajuego .selection-help { width: 100%; white-space: normal; color: var(--cj-muted); margin-top: 8px; }
.creajuego .property-group { padding: 10px 2px; margin-right: 4px; margin-bottom: 4px; border-bottom-width: 1px; border-bottom-color: var(--cj-border); }
.creajuego .group-title { font-size: 13px; -unity-font-style: bold; margin-bottom: 10px; color: var(--cj-text); }
.creajuego .property { margin-bottom: 12px; }
.creajuego .property .unity-base-field { flex-direction: column; align-items: stretch; margin-left: 0; margin-right: 0; }
.creajuego .property .unity-base-field__label { min-width: 0; margin-bottom: 6px; white-space: normal; color: var(--cj-text); }
.creajuego .property .unity-base-field__input { min-height: 28px; }
.creajuego .property .unity-base-text-field__input { background-color: #ffffff; color: var(--cj-text); border-width: 1px; border-color: var(--cj-border); border-radius: 4px; }
.creajuego .property .unity-base-text-field__input:focus { border-color: var(--cj-accent); border-width: 2px; }
.creajuego .property .unity-toggle { flex-direction: row; }
.creajuego .property .unity-toggle__input { flex-grow: 0; margin-left: 8px; }
.creajuego .property .unity-toggle__checkmark { border-width: 1px; border-color: var(--cj-muted); }
.creajuego .property .unity-slider__dragger { background-color: var(--cj-accent); width: 16px; height: 16px; border-radius: 8px; }
.creajuego .property .unity-slider__tracker { background-color: var(--cj-border); }
.creajuego .message .unity-text-field__input { min-height: 64px; white-space: normal; }
.creajuego .unit { color: var(--cj-muted); font-size: 11px; }
.creajuego .category { font-size: 12px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 6px; }
.creajuego .actions { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.creajuego .actions Button { margin-right: 5px; margin-bottom: 5px; }
.creajuego .danger-action { color: var(--cj-danger); }
.creajuego .empty { white-space: normal; color: var(--cj-muted); margin: 20px 8px; font-size: 16px; }
.creajuego .empty-title { white-space: normal; color: var(--cj-text); font-size: 14px; margin-top: 8px; }
.creajuego .context-help { white-space: normal; color: var(--cj-muted); background-color: #edf5ff; padding: 12px; border-left-width: 3px; border-left-color: var(--cj-accent); }
.creajuego .status { white-space: normal; color: var(--cj-muted); padding-top: 6px; font-size: 12px; }
.creajuego .play-footer {
    flex-direction: row; align-items: center; flex-shrink: 0;
    padding: 8px; margin-top: 10px; border-width: 1px; border-color: var(--cj-border); border-radius: 6px;
    background-color: var(--cj-panel);
}
.creajuego .play-footer.ready { background-color: var(--cj-success-bg); border-color: var(--cj-success); }
.creajuego .play-footer.needs-help { background-color: var(--cj-warning-bg); border-color: #b78232; }
.creajuego .validation { flex-grow: 1; flex-shrink: 1; min-width: 0; max-height: 106px; margin-right: 10px; }
.creajuego .preflight-title { font-size: 16px; -unity-font-style: bold; white-space: normal; color: var(--cj-text); }
.creajuego .ready .preflight-title { color: var(--cj-success); }
.creajuego .needs-help .preflight-title { color: var(--cj-warning); }
.creajuego .check-list { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.creajuego .check-list Label { white-space: normal; font-size: 12px; margin-right: 12px; margin-bottom: 3px; }
.creajuego .check-ok { color: var(--cj-success); }
.creajuego .check-missing { color: var(--cj-warning); }
.creajuego .primary { min-width: 130px; height: 48px; flex-shrink: 0; background-color: var(--cj-success); border-color: var(--cj-success); color: #ffffff; font-size: 19px; -unity-font-style: bold; }
.creajuego .primary:hover { background-color: #065b32; border-color: #065b32; }
.creajuego .primary:focus { border-color: #14264b; border-width: 3px; }

.creajuego.elements-window .catalog { flex-grow: 3; min-height: 70px; }
.creajuego.elements-window .game-items { flex-grow: 2; min-height: 65px; }
.creajuego.elements-window .section-title { margin-top: 8px; }
.creajuego.elements-window .actions Button { padding-left: 6px; padding-right: 6px; font-size: 12px; }
.creajuego.playbar-window .play-footer { flex-grow: 1; min-height: 65px; margin-top: 0; }
.creajuego.playbar-window .validation { max-height: none; }
.creajuego.playbar-window .status { font-size: 11px; }
